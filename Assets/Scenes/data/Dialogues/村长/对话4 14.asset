  characterData: {fileID: 11400000, guid: be95ea9d4e0ba9042895862fac8e2352, type: 2}
  dialogueText: "\uFF08\u773C\u795E\u575A\u5B9A\u5982\u94C1\uFF0C\u8BED\u6C14\u91CC\u5E26\u7740\u4E0D\u5BB9\u7F6E\u7591\u7684\u51B3\u7EDD\uFF09\u6211\u77E5\u9053\u4E86\uFF0C\u6751\u957F\u3002\u8FD9\u80A1\u5929\u8D4B\uFF0C\u8FD9\u4EFD\u8D23\u4EFB\uFF0C\u6211\u90FD\u4F1A\u63A5\u8FC7\u6765\u3002\u6211\u4E00\u5B9A\u4F1A\u5288\u5F00\u90A3\u5DE8\u77F3\uFF0C\u6740\u8FDB\u6D1E\u7A74\uFF0C\u628A\u91CC\u9762\u7684\u9B54\u7269\u5168\u90E8\u6E05\u527F\u5E72\u51C0\uFF0C\u4E3A\u7236\u4EB2\u62A5\u4EC7\uFF0C\u8FD8\u6751\u5B50\u4E00\u4E2A\u5F7B\u5E95\u7684\u5B89\u5B81\uFF01"
