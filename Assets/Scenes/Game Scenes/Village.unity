  m_text: "    \u5F53\u4F60\u8BFB\u5230\u8FD9\u4E9B\u8BDD\u65F6\uFF0C\u8BF4\u660E\u6211\u5DF2\u65E0\u6CD5\u4EB2\u81EA\u6307\u5BFC\u4F60\u4E86\u3002\u4E0D\u5FC5\u60B2\u4F24\uFF0C\u5B88\u536B\u7684\u804C\u8D23\u9AD8\u4E8E\u4E00\u5207\uFF0C\u800C\u6211\u5DF2\u5C06\u6700\u5B9D\u8D35\u7684\u8D22\u5BCC\u2014\u2014\u4F60\uFF0C\u7559\u7ED9\u4E86\u8FD9\u7247\u571F\u5730\u3002\n   
