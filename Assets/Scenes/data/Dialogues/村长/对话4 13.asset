  characterData: {fileID: 11400000, guid: fcbe25267ed73bf4b9753da0a8d35fde, type: 2}
  dialogueText: "\uFF08\u7236\u4EB2\u6218\u6B7B\u7684\u753B\u9762\u4E0E\u6751\u957F\u7684\u8BDD\u8BED\u4EA4\u7EC7\u5728\u4E00\u8D77\uFF0C\u60B2\u75DB\u4E0E\u6012\u706B\u5728\u4F60\u80F8\u4E2D\u71C3\u70E7\u3002\u4F60\u7EC8\u4E8E\u660E\u767D\uFF0C\u6751\u957F\u5F53\u521D\u4E3A\u4F55\u6267\u610F\u8981\u8BA9\u4F60\u63A5\u4EFB\u5B88\u536B\uFF0C\u4E5F\u660E\u767D\u7236\u4EB2\u7559\u4E0B\u7684\u4E0D\u4EC5\u4EC5\u662F\u4E00\u672C\u5B88\u536B\u624B\u518C\uFF0C\u8FD8\u6709\u8FD9\u4EFD\u5B88\u62A4\u6751\u5E84\u7684\u529B\u91CF\u3002\uFF09"
