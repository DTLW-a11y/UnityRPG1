  dialogueText: "\uFF08\u6751\u957F\u6B23\u6170\u5730\u70B9\u70B9\u5934\uFF0C\u53C8\u7A81\u7136\u60F3\u5230\u4E86\u4EC0\u4E48\uFF0C\u4ECE\u6000\u91CC\u638F\u51FA\u4E00\u4E2A\u5C42\u5C42\u53E0\u53E0\u88F9\u5F97\u4E25\u5B9E\u7684\u5E03\u5305\uFF0C\u6751\u957F\u5C0F\u5FC3\u7FFC\u7FFC\u5730\u6253\u5F00\uFF0C\u91CC\u9762\u8EBA\u7740\u4E00\u9897\u9E3D\u86CB\u5927\u5C0F\u7684\u84DD\u8272\u5B9D\u77F3\uFF0C\u5B9D\u77F3\u901A\u4F53\u5254\u900F\uFF0C\u8868\u9762\u6D41\u8F6C\u7740\u6DE1\u6DE1\u7684\u5149\u6655\u3002\uFF09"
