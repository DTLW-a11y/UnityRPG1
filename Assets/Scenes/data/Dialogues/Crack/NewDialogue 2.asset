  characterData: {fileID: 11400000, guid: fcbe25267ed73bf4b9753da0a8d35fde, type: 2}
  dialogueText: "\uFF08\u6D1E\u7A74\u5185\u7684\u9634\u51B7\u6C14\u606F\u5728\u4E0D\u65AD\u51CF\u5F31\uFF0C\u90A3\u80A1\u6765\u81EA\u53E6\u4E00\u4E2A\u4E16\u754C\u7684\u90AA\u5F02\u80FD\u91CF\u6B63\u5728\u88AB\u5B9D\u77F3\u538B\u5236\u3002\u4E0D\u591A\u65F6\uFF0C\u968F\u7740\u201C\u55E1\u201D\u7684\u4E00\u58F0\u8F7B\u54CD\uFF0C\u65F6\u7A7A\u88C2\u7F1D\u5F7B\u5E95\u95ED\u5408\uFF0C\u5B9D\u77F3\u7684\u5149\u8292\u4E5F\u6E10\u6E10\u9EEF\u6DE1\uFF0C\u7F13\u7F13\u843D\u5728\u4F60\u624B\u4E2D\u3002\uFF09"
