  dialogueText: "\u6628\u665A\u9B54\u7269\u53C8\u6765\u52AB\u63A0\u6751\u5E84\u4E86\uFF0C\u6751\u897F\u5F20\u5A76\u5BB6\u6700\u540E\u4E00\u70B9\u5B58\u7CAE\u88AB\u62A2\u4E86\u4E2A\u5E72\u51C0\uFF0C\u5979\u90A3\u5C0F\u5B59\u5B50\u997F\u5F97\u76F4\u54ED\uFF0C\u55D3\u5B50\u90FD\u54D1\u4E86\uFF1B\u8FD8\u6709\u94C1\u5320\u5218\u4F2F\uFF0C\u4E3A\u4E86\u62A4\u7740\u81EA\u5BB6\u7684\u5DE5\u5177\uFF0C\u88AB\u9B54\u7269\u6293\u4F24\u4E86\u817F\uFF0C\u73B0\u5728\u8FDE\u8DEF\u90FD\u8D70\u4E0D\u4E86\u2026\u2026"
