  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "    \u5F53\u4F60\u8BFB\u5230\u8FD9\u4E9B\u8BDD\u65F6\uFF0C\u8BF4\u660E\u6211\u5DF2\u65E0\u6CD5\u4EB2\u81EA\u6307\u5BFC\u4F60\u4E86\u3002\u4E0D\u5FC5\u60B2\u4F24\uFF0C\u5B88\u536B\u7684\u804C\u8D23\u9AD8\u4E8E\u4E00\u5207\uFF0C\u800C\u6211\u5DF2\u5C06\u6700\u5B9D\u8D35\u7684\u8D22\u5BCC\u2014\u2014\u4F60\uFF0C\u7559\u7ED9\u4E86\u8FD9\u7247\u571F\u5730\u3002\n   
    \u624B\u518C\u91CC\u7684\u6280\u5DE7\u52A1\u5FC5\u8981\u52E4\u52A0\u7EC3\u4E60\uFF0C\u4F46\u66F4\u8981\u8BB0\u4F4F\uFF1A\u771F\u6B63\u7684\u5B88\u536B\uFF0C\u529B\u91CF\u6C38\u8FDC\u6765\u81EA\u4ED6\u6240\u5B88\u62A4\u7684\u4EBA\u548C\u5730\u65B9\u3002\u4FDD\u6301\u8B66\u60D5\uFF0C\u4F46\u4E0D\u5FC5\u6050\u60E7\uFF1B\u503E\u542C\u98CE\u58F0\u3001\u89C2\u5BDF\u6811\u5F71\uFF0C\u6751\u5E84\u4F1A\u544A\u8BC9\u4F60\u5371\u9669\u6765\u81EA\u4F55\u65B9\u3002\r\n\r   
    \u53BB\u6218\u6597\u5427\uFF0C\u53BB\u5B88\u62A4\u5427\u3002\u8FD9\u672C\u518C\u5B50\u4F1A\u4F34\u4F60\u524D\u884C\uFF0C\u6B63\u5982\u6211\u7684\u76EE\u5149\u5C06\u6C38\u8FDC\u6CE8\u89C6\u7740\u4F60\u3002\u4F60\u4E0D\u4EC5\u662F\u6211\u7684\u5B69\u5B50\uFF0C\u66F4\u662F\u6211\u6B64\u751F\u6700\u9A84\u50B2\u7684\u5EF6\u7EED\uFF0C\u4E0E\u6700\u575A\u5B9A\u7684\u7EE7\u627F\u8005\u3002\n\r   
    \r\u613F\u4F60\u7684\u5251\u950B\u6C38\u8FDC\u4E3A\u5B88\u62A4\u800C\u51FA\u9798\uFF0C\u613F\u4F60\u7684\u76FE\u724C\u6C38\u8FDC\u56E0\u4FE1\u5FF5\u800C\u575A\u56FA\u3002\r\n\r   
    \u6751\u5B50\uFF0C\u5C31\u4EA4\u7ED9\u4F60\u4E86\u3002\r\n\r\n                                                                        
    \u2014\u2014 \u6C38\u8FDC\u4E0E\u4F60\u540C\u5728"
